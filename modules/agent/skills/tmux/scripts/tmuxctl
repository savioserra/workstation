#!/usr/bin/env python3
# tmuxctl — the agent's pane surface: inspect, read, operate, watch.
# Stdlib only. The watch verb rides tmux control mode (%output push).

import argparse
import os
import re
import shutil
import subprocess
import sys
import threading
import queue
import time


def _find_tmux():
    # the substrate's tmux first: gateway environments carry no nix PATH and a
    # distro tmux answers a newer server with 'server exited unexpectedly'
    cands = [
        os.environ.get("TMUXCTL_TMUX"),
        os.path.expanduser("~/.nix-profile/bin/tmux"),
        "/run/current-system/sw/bin/tmux",
        shutil.which("tmux"),
    ]
    for cand in cands:
        if cand and os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return "tmux"


TMUX = _find_tmux()


def die(msg, code=2):
    print(f"tmuxctl: {msg}", file=sys.stderr)
    sys.exit(code)


def base_cmd(socket):
    cmd = [TMUX]
    if socket:
        cmd += ["-L", socket]
    return cmd


def run_tmux(socket, args, input_bytes=None):
    r = subprocess.run(
        base_cmd(socket) + args, capture_output=True, input=input_bytes
    )
    if r.returncode != 0:
        die(
            "tmux {} failed: {}".format(
                " ".join(args[:2]), r.stderr.decode(errors="replace").strip()
            ),
            1,
        )
    return r.stdout.decode(errors="replace")


def pane_env():
    return os.environ.get("TMUX_PANE", "")


# --- inspect ---------------------------------------------------------------

FMT = "#{pane_id}\t#{session_name}:#{window_index}.#{pane_index}\t#{pane_current_command}\t#{pane_title}\t#{pane_width}x#{pane_height}\t#{pane_dead}"


def cmd_ps(args):
    out = run_tmux(args.socket, ["list-panes", "-a", "-F", FMT])
    lines = [l for l in out.splitlines() if l.strip()]
    if not args.all:
        mine = pane_env()
        if mine:
            sess = run_tmux(
                args.socket,
                ["display-message", "-p", "-t", mine, "#{session_name}"],
            ).strip()
            lines = [l for l in lines if l.split("\t")[1].startswith(sess + ":")]
    for l in lines:
        print(l)
    if not lines:
        die("no panes matched", 1)


# --- read ------------------------------------------------------------------

def cmd_read(args):
    info = run_tmux(
        args.socket,
        [
            "display-message",
            "-p",
            "-t",
            args.pane,
            "#{cursor_y}\t#{cursor_x}\t#{pane_in_mode}\t#{alternate_on}\t#{history_size}",
        ],
    ).strip()
    rows = [f"{args.pane}"]
    rows.append("cursor={}x{} mode={} alt-history={} scrollback={}".format(*info.split("\t")))
    cap = ["capture-pane", "-p", "-J", "-t", args.pane]
    if args.escape:
        cap.insert(2, "-e")
    if args.scrollback:
        cap += ["-S", f"-{args.scrollback}"]
    body = run_tmux(args.socket, cap)
    print("\n".join(rows))
    print(body.rstrip("\n"))


# --- operate ---------------------------------------------------------------

MAX_TYPE = 1990


def cmd_type(args):
    if len(args.text) > MAX_TYPE:
        die(f"text over {MAX_TYPE} bytes — use: tmuxctl paste {args.pane}", 2)
    run_tmux(args.socket, ["send-keys", "-l", "-t", args.pane, args.text])


def cmd_key(args):
    run_tmux(args.socket, ["send-keys", "-t", args.pane, *args.keys])


def cmd_paste(args):
    data = sys.stdin.buffer.read()
    if not data:
        die("paste reads a block from stdin", 2)
    buf = f"tmuxctl-{os.getpid()}"
    run_tmux(
        args.socket,
        ["load-buffer", "-b", buf, "-"],
        input_bytes=data,
    )
    run_tmux(
        args.socket,
        ["paste-buffer", "-p", "-r", "-b", buf, "-t", args.pane],
    )
    run_tmux(args.socket, ["delete-buffer", "-b", buf])


def cmd_hex(args):
    for tok in args.bytes:
        if not re.fullmatch(r"(?:[0-9a-fA-F]{2})+", tok):
            die(f"hex tokens are even-length hex bytes: {tok}", 2)
    run_tmux(args.socket, ["send-keys", "-H", "-t", args.pane, *args.bytes])


def cmd_run(args):
    if len(args.command) > MAX_TYPE:
        die(f"command over {MAX_TYPE} bytes — use paste + key Enter", 2)
    if args.no_wait:
        run_tmux(args.socket, ["send-keys", "-l", "-t", args.pane, args.command])
        run_tmux(args.socket, ["send-keys", "-t", args.pane, "Enter"])
        return
    run_wait(args)


HELPERS_OPT = "@tmuxctl_helpers"


def _miss(name):
    # the shell's own complaint that a marker helper is not on its PATH:
    # a line of its own, never the echoed command text
    return re.compile(
        rf"(?m)^\r?(?:(?:[-\w./]+: )?(?:\d+: )?{name}: (?:command )?not found"
        rf"|[-\w./]+: command not found: {name}"
        rf"|Command '{name}' not found"
        rf"|'{name}' is not recognized"
        rf"|(?:fish: )?Unknown command:? {name})"
    )


# the distro's suggestions after a missing command
_SUGGEST = re.compile(r"did you mean|^\s*command '.*' from |^See 'snap info")


def helpers_state(socket, pane):
    r = subprocess.run(
        base_cmd(socket) + ["display-message", "-p", "-t", pane, "#{" + HELPERS_OPT + "}"],
        capture_output=True,
    )
    return r.stdout.decode(errors="replace").strip()


def set_helpers(socket, pane, value):
    subprocess.run(
        base_cmd(socket) + ["set-option", "-p", "-t", pane, HELPERS_OPT, value],
        capture_output=True,
    )


def run_wait(args):
    """Type the command, submit, ride %output until the shell prints the
    completion marker (an OSC escape — invisible on screen), yield the
    transcript slice and the command's exit code. --await returns on a
    readiness pattern instead, while the command keeps running.

    The pane echoes the short ws-go/ws-done tokens. A pane whose shell
    lacks them is remembered (a pane option) and gets inline markers."""
    nonce = f"{os.getpid():x}{time.monotonic_ns() % 0xFFFF:x}"
    marker = f"tmuxctl:{nonce}"
    state = helpers_state(args.socket, args.pane)
    if state == "absent":
        start = (
            f"command -v ws-go >/dev/null 2>&1 && ws-go {nonce} "
            f"|| printf '\\033]7777;{marker}:start:i\\007' ; "
        )
        wrap = (
            f" ; rc=$?; command -v ws-done >/dev/null 2>&1 && ws-done {nonce} $rc "
            f"|| printf '\\033]7777;{marker}:end:%s\\007' $rc"
        )
    else:
        start = f"ws-go {nonce} ; "
        wrap = f" ; ws-done {nonce} $?"
    start_rx = re.compile("\x1b\\]7777;" + re.escape(marker) + ":start(:i)?\\007")
    marker_rx = re.compile("\x1b\\]7777;" + re.escape(marker) + r":end:(\d+)")
    miss_go, miss_done = _miss("ws-go"), _miss("ws-done")
    await_rx = re.compile(args.await_re) if args.await_re else None
    session = pane_session(args.socket, args.pane)
    cc = ControlClient(args.socket, session)
    out = []
    code = None
    awaited = False
    started = False
    degraded = False
    finished = False
    rc = 124
    deadline = time.monotonic() + (args.timeout or 180)
    try:
        run_tmux(args.socket, ["send-keys", "-l", "-t", args.pane, start + args.command + wrap])
        run_tmux(args.socket, ["send-keys", "-t", args.pane, "Enter"])
        while time.monotonic() < deadline:
            wait = max(0.0, deadline - time.monotonic())
            try:
                line = cc.q.get(timeout=wait)
            except queue.Empty:
                break
            if line is None:
                rc = 125
                break
            if not line.startswith("%output"):
                continue
            parts = line.split(" ", 2)
            if len(parts) < 3 or parts[1] != args.pane:
                continue
            payload = unescape(parts[2])
            if not started:
                # matching activates only at the shell's own start marker —
                # the echo and any zle redraw of the typed line precede it
                sm = start_rx.search(payload)
                if sm:
                    started = True
                    seen = "absent" if sm.group(1) else "present"
                    if seen != state:
                        set_helpers(args.socket, args.pane, seen)
                    payload = payload[sm.end() :]
                else:
                    cleaned = clean(payload, False)
                    mg = miss_go.search(cleaned)
                    if not mg:
                        continue
                    # no helpers in this shell: the command still runs, its
                    # end shows as the shell's complaint about ws-done
                    started = True
                    degraded = True
                    set_helpers(args.socket, args.pane, "absent")
                    payload = cleaned[mg.end() :]
                if not payload:
                    continue
            m = marker_rx.search(payload)
            hit = None
            pre = ""
            if m:
                hit = m
                pre = clean(payload[: m.start()], False)
            else:
                cleaned = clean(payload, False)
                md = miss_done.search(cleaned) if degraded else None
                if md:
                    hit = md
                    finished = True
                elif await_rx:
                    hit = await_rx.search(cleaned)
                pre = cleaned[: hit.start()] if hit else ""
                if finished:
                    # drop the shell-name prefix of the complaint line
                    pre = pre.rsplit("\n", 1)[0] if "\n" in pre else ""
            if hit:
                for ln in pre.splitlines():
                    if ln.strip() and "]7777;tmuxctl:" not in ln:
                        out.append(ln)
                if m:
                    code = int(m.group(1))
                    rc = 0 if code == 0 else 1
                elif finished:
                    rc = 5
                else:
                    awaited = True
                    rc = 0
                break
            text = clean(payload, False)
            for ln in text.splitlines():
                if ln.strip() and "]7777;tmuxctl:" not in ln:
                    out.append(ln)
    finally:
        cc.close()
    if degraded:
        out = [ln for ln in out if not _SUGGEST.search(ln)]
    if out:
        print("\n".join(out)[-4000:])
    if awaited:
        print("--- await matched (still running) ---")
    elif code is not None:
        print(f"--- exit {code} ---")
    elif finished:
        print(
            "--- finished, exit code unknown: this pane's shell has no "
            "ws-go/ws-done; later runs here use inline markers ---"
        )
    sys.exit(rc)


def cmd_split(args):
    a = ["split-window", "-t", args.target_pane]
    if args.horizontal:
        a += ["-h"]
    if args.size:
        a += ["-l", args.size]
    out = run_tmux(args.socket, a + ["-P", "-F", "#{pane_id}"])
    print(out.strip())


def cmd_kill(args):
    for pane in args.panes:
        if pane == pane_env():
            die("refusing to kill this agent's own pane ($TMUX_PANE)", 2)
        run_tmux(args.socket, ["kill-pane", "-t", pane])


# --- watch (control mode) --------------------------------------------------

OCTAL = re.compile(r"\\([0-7]{3})")
SGR = re.compile(r"\x1b\[[0-9;?]*[a-zA-Z]")
OSC = re.compile(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")


def unescape(line):
    return OCTAL.sub(lambda m: chr(int(m.group(1), 8)), line)


def clean(text, keep_sgr):
    if keep_sgr:
        return text
    return OSC.sub("", SGR.sub("", text))


def pane_session(socket, pane):
    return run_tmux(
        socket, ["display-message", "-p", "-t", pane, "#{session_name}"]
    ).strip()


class ControlClient:
    """One control-mode client; %output lines land on a queue (blocking)."""

    def __init__(self, socket, session):
        cmd = base_cmd(socket) + ["-C", "attach", "-t", session]
        self.proc = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        self.q = queue.Queue()
        self.reader = threading.Thread(target=self._read, daemon=True)
        self.reader.start()

    def _read(self):
        for line in self.proc.stdout:
            self.q.put(line.decode(errors="replace").rstrip("\n"))
        self.q.put(None)

    def send(self, command):
        self.proc.stdin.write((command + "\n").encode())
        self.proc.stdin.flush()

    def close(self):
        try:
            self.proc.stdin.close()
        except OSError:
            pass
        self.proc.terminate()


def cmd_watch(args):
    session = pane_session(args.socket, args.pane)
    targets = {args.pane} if not args.all else None
    cc = ControlClient(args.socket, session)
    tail = []
    matched = []
    idle_deadline = None
    deadline = time.monotonic() + args.timeout if args.timeout else None
    rx = re.compile(args.until) if args.until else None
    rc = 0
    try:
        while True:
            now = time.monotonic()
            wait = None
            if args.idle:
                idle_deadline = idle_deadline or now + args.idle
                wait = max(0.0, idle_deadline - now)
            if deadline is not None:
                wait = min(wait, deadline - now) if wait is not None else deadline - now
                if wait < 0:
                    wait = 0.0
            try:
                line = cc.q.get(timeout=wait)
            except queue.Empty:
                line = None
            if line is None:
                if args.idle and idle_deadline and time.monotonic() >= idle_deadline:
                    rc = 3
                    break
                if deadline is not None and time.monotonic() >= deadline:
                    rc = 124
                    break
                continue
            if not line.startswith("%output"):
                if line in ("%exit",):
                    break
                continue
            parts = line.split(" ", 2)
            if len(parts) < 3:
                continue
            pane, payload = parts[1], unescape(parts[2])
            if targets is not None and pane not in targets:
                continue
            if args.idle:
                idle_deadline = time.monotonic() + args.idle
            text = clean(payload, args.raw)
            for chunk in text.splitlines() or [text]:
                shown = f"{pane} {chunk}" if args.all else chunk
                print(shown)
                tail.append(shown)
                if len(tail) > 50:
                    tail.pop(0)
                if rx is not None and rx.search(chunk):
                    matched.append(shown)
                    if not args.keep_watching:
                        rc = 0
                        return finish(cc, matched, rc)
            if deadline is not None and time.monotonic() >= deadline:
                rc = 124
                break
    except KeyboardInterrupt:
        rc = 130
    finish(cc, matched, rc)


def finish(cc, matched, rc):
    cc.close()
    if matched:
        print("--- matched ---")
        for m in matched[-5:]:
            print(m)
    sys.exit(rc)


# --- cli -------------------------------------------------------------------

def main():
    p = argparse.ArgumentParser(prog="tmuxctl", description="the agent's pane surface")
    p.add_argument("-L", dest="socket", default=None, help="socket name (scratch servers)")
    sub = p.add_subparsers(dest="verb", required=True)

    s = sub.add_parser("ps", help="list panes")
    s.add_argument("-a", "--all", action="store_true", help="every session, not just this one")
    s.set_defaults(fn=cmd_ps)

    s = sub.add_parser("read", help="snapshot a pane")
    s.add_argument("pane", metavar="PANE")
    s.add_argument("-S", dest="scrollback", type=int, default=0, help="scrollback lines")
    s.add_argument("-e", dest="escape", action="store_true", help="keep SGR escapes")
    s.set_defaults(fn=cmd_read)

    s = sub.add_parser("type", help="literal text, no Enter")
    s.add_argument("pane", metavar="PANE")
    s.add_argument("text")
    s.set_defaults(fn=cmd_type)

    s = sub.add_parser("key", help="named keys (Enter, C-c, Escape, ...)")
    s.add_argument("pane", metavar="PANE")
    s.add_argument("keys", nargs="+")
    s.set_defaults(fn=cmd_key)

    s = sub.add_parser("paste", help="bracketed paste block from stdin")
    s.add_argument("pane", metavar="PANE")
    s.set_defaults(fn=cmd_paste)

    s = sub.add_parser("hex", help="raw bytes as hex tokens")
    s.add_argument("pane", metavar="PANE")
    s.add_argument("bytes", nargs="+", metavar="BYTE")
    s.set_defaults(fn=cmd_hex)

    s = sub.add_parser("run", help="type a command line, submit it, wait for completion")
    s.add_argument("pane", metavar="PANE")
    s.add_argument("command")
    s.add_argument("--no-wait", action="store_true", help="submit and return immediately")
    s.add_argument("--await", dest="await_re", default=None, help="regex: return when it matches pane output (command keeps running)")
    s.add_argument("--timeout", type=float, default=180.0, help="wait cap in seconds")
    s.set_defaults(fn=cmd_run)

    s = sub.add_parser("split", help="split a pane's window; prints the new pane id")
    s.add_argument("target_pane", metavar="PANE")
    s.add_argument("-H", "--horizontal", dest="horizontal", action="store_true", help="side by side (default: stacked)")
    s.add_argument("-l", dest="size", default=None, help="size spec (cells, percent, or panes)")
    s.set_defaults(fn=cmd_split)

    s = sub.add_parser("kill", help="kill panes (never this agent's own)")
    s.add_argument("panes", nargs="+", metavar="PANE")
    s.set_defaults(fn=cmd_kill)

    s = sub.add_parser("watch", help="stream pane output (control mode, no polling)")
    s.add_argument("pane", metavar="PANE")
    s.add_argument("--until", default=None, help="exit 0 when this regex matches")
    s.add_argument("--idle", type=float, default=0.0, help="exit 3 after N silent seconds")
    s.add_argument("--timeout", type=float, default=0.0, help="exit 124 at N seconds")
    s.add_argument("--all", action="store_true", help="every pane in the session, pane-id prefixed")
    s.add_argument("--raw", action="store_true", help="keep SGR escapes")
    s.add_argument("--keep-watching", action="store_true", help="stay after --until matches")
    s.set_defaults(fn=cmd_watch)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
