# The database domain: harlequin and the hsql agent skill generated by
# `hsql --skill` from the installed package.
{
  config,
  lib,
  pkgs,
  ...
}:
let
  ws = import ../../nix/lib/capability.nix { inherit config lib pkgs; };
  hsqlSkill =
    pkgs.runCommand "hsql-agent-skill-${pkgs.harlequin.version}"
      {
        nativeBuildInputs = [ pkgs.harlequin ];
        passthru.version = pkgs.harlequin.version;
      }
      ''
        export HOME="$TMPDIR/home"
        mkdir -p "$HOME" "$TMPDIR/skill"
        hsql --skill -o "$TMPDIR/skill"
        mkdir -p "$out"
        cp -a "$TMPDIR/skill/." "$out/"
      '';
in
ws.capability [ "database" ] {
  description = "harlequin and the hsql agent skill";
  default = true;
  config = {
    home.packages = [ pkgs.harlequin ];
    programs.hermes.skills = ws.whenOn "agent" {
      hsql = {
        enable = true;
        source = hsqlSkill;
      };
    };
    workstation.terminal.nunchux = ws.whenOn [ "terminal" "nunchux" ] {
      entries."app:sql" = {
        cmd = "harlequin";
        desc = "SQL IDE";
        primary_action = "window";
        rank = 20;
      };
    };
  };
}
